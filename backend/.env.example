# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
MAX_USERS=100

# Refresh-token encryption keys, "<version>:<base64-urlsafe 32-byte key>,...". Generate a key with:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# TOKEN_ENCRYPTION_KEYS=1:<key>
# TOKEN_ENCRYPTION_CURRENT_VERSION=1

# Added in later weeks (values live in host secrets, never in the repo):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=
# ANTHROPIC_API_KEY=
