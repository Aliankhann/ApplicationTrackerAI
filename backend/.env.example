# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of this API, used in digest unsubscribe links
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
MAX_USERS=100

# Refresh-token encryption keys, "<version>:<base64-urlsafe 32-byte key>,...". Generate a key with:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# TOKEN_ENCRYPTION_KEYS=1:<key>
# TOKEN_ENCRYPTION_CURRENT_VERSION=1

# Added in later weeks (values live in host secrets, never in the repo):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=
# ANTHROPIC_API_KEY=

# Below this confidence a classification is flagged "needs review" and changes no status (0..1)
# CLASSIFIER_REVIEW_THRESHOLD=0.7

# Follow-up scheduler: drafts per user per local day, and the timezone for users who have none
# FOLLOWUP_DAILY_DRAFT_CAP=5
# DEFAULT_TIMEZONE=America/Toronto
# Steps already overdue by more than this many days when planned are skipped
# FOLLOWUP_STALE_DAYS=3
# GHOSTED_AFTER_DAYS=21
# SCHEDULER_LEASE_MINUTES=15

# Sessions. Required (>= 32 bytes) outside local; generate with `openssl rand -hex 32`.
SESSION_SECRET=
# Set to e.g. .example.com when the API and frontend share a parent domain.
COOKIE_DOMAIN=

# Google sign-in (OIDC). Without all three, the sign-in routes answer 503 sign_in_unavailable.
# Redirect URI must match the Cloud console entry exactly, e.g. https://api.<domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Gmail connect redirect (register it in the Google console). Defaults to /gmail/callback on the
# same origin as GOOGLE_REDIRECT_URI.
GOOGLE_CONNECT_REDIRECT_URI=
# Comma-separated emails that may sign in without an invite code (may be empty).
ALLOWLIST_EMAILS=
# Number of reverse proxies in front of the API that append to X-Forwarded-For. 0 = ignore the
# header (safe default); 1 = trust the last entry, and so on. It must equal the REAL number of
# proxies: too high lets clients spoof their IP and dodge limits; 0 behind a proxy puts everyone
# in one bucket (the proxy's address), so one abuser locks out all users.
TRUSTED_PROXY_COUNT=0

# Claude fallback classifier. OFF by default; enabling is a human decision after the Google
# Limited Use review and the vendor data-terms check.
LLM_ENABLED=false
# ANTHROPIC_API_KEY=  # set via host secrets, never commit
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_CAP_PER_USER=50
LLM_MONTHLY_CALL_BUDGET=5000
LLM_REJECTION_THRESHOLD=0.9
